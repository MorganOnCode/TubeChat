# tubechat environment contract (self-hosted)
# Copy to .env and fill in. .env is gitignored.

# --- Runtime (web container) ---
# Postgres connection. In compose this is built from POSTGRES_* and points at
# the internal `postgres` host. Set directly for laptop scripts (port 5433).
DATABASE_URL=postgres://tubechat:CHANGE_ME@localhost:5433/tubechat
OPENAI_API_KEY=                 # required: embeddings + RAG (gpt-4o-mini, text-embedding-3-small)
YOUTUBE_API_KEY=                # ingestion only (channel/video metadata)
SUPADATA_API_KEY=               # ingestion only (transcript fallback API)
CRON_SECRET=                    # protects /api/cron/ingest

# --- Postgres (docker-compose.prod.yml) ---
POSTGRES_DB=tubechat
POSTGRES_USER=tubechat
POSTGRES_PASSWORD=CHANGE_ME     # openssl rand -hex 24
