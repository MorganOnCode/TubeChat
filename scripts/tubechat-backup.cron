# tubechat nightly Postgres backup (restic → cloud bucket)
#
# Install:
#   sudo cp /opt/tubechat/scripts/tubechat-backup.cron /etc/cron.d/tubechat-backup
#   sudo chmod 644 /etc/cron.d/tubechat-backup
#
# Logs: /opt/tubechat/data/backup.log
# Verify restores periodically:  restic snapshots   (with .backup.env sourced)

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=""

# Nightly at 03:30 UTC. Offset from cardano402's 03:00 job to avoid I/O overlap.
30 3 * * * morganic /opt/tubechat/scripts/backup.sh >> /opt/tubechat/data/backup.log 2>&1
