# tubechat backup credentials — copy to .backup.env (gitignored) and fill in.
#
#   cp .backup.env.example .backup.env && chmod 600 .backup.env
#
# RESTIC_REPOSITORY — where backups go. Examples by provider:
#   Backblaze B2:    b2:YOUR_BUCKET:tubechat
#   AWS S3:          s3:s3.amazonaws.com/YOUR_BUCKET/tubechat
#   Cloudflare R2:   s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/YOUR_BUCKET/tubechat
#   Wasabi:          s3:s3.eu-central-1.wasabisys.com/YOUR_BUCKET/tubechat
#   SFTP/local:      sftp:user@host:/path   |   /mnt/backup/tubechat
RESTIC_REPOSITORY=

# RESTIC_PASSWORD — encrypts the repo. Generate once and STORE IT SAFELY
# (without it the backups are unrecoverable):  openssl rand -base64 32
RESTIC_PASSWORD=

# ── Provider credentials — uncomment the set that matches your repo type ──

# Backblaze B2:
# B2_ACCOUNT_ID=
# B2_ACCOUNT_KEY=

# AWS S3 / Cloudflare R2 / Wasabi (S3-compatible):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
